{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "name": "Nuit", "color": "#0E1A2B" },
        { "slug": "contrast", "name": "Lune", "color": "#F4F1EA" },
        { "slug": "accent", "name": "Lampion", "color": "#FFB547" }
      ]
    },
    "typography": { "fluid": false }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } },
      "h1": { "typography": { "fontSize": "clamp(2.25rem, 12vw, 6rem)", "lineHeight": "1.1" } }
    }
  }
}
