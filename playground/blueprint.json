{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Les Nuits du Quai · groupe B",
    "description": "Le site du festival, avec le thème enfant de la branche main et un contenu de démonstration.",
    "author": "Media Design lab"
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "steps": [
    { "step": "setSiteLanguage", "language": "fr_FR" },
    {
      "step": "installTheme",
      "themeData": { "resource": "wordpress.org/themes", "slug": "twentytwentyfive" },
      "options": { "activate": false }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/MediaDesignLab-EDNA/vibe-coding-groupe-b",
        "ref": "main",
        "refType": "branch",
        "path": "theme/festival-child"
      },
      "options": { "activate": true, "targetFolderName": "festival-child" }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/contenu-demo.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/MediaDesignLab-EDNA/vibe-coding-groupe-b/main/playground/contenu.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/contenu-demo.php';"
    }
  ]
}
